#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROGRAM_NAME="$(basename "$0")"

DB_DIR="$SCRIPT_DIR/DB"
SCRIPT_script_DIR="$SCRIPT_DIR/script";

INPUT_FILE=""
OUTPUT=""
SKANI_DB=""
VERSION="1.2"
# Total CPU budget
threads=8

# Thread settings for tools with native threading.
# 0 means use total threads.
DIAMOND_THREADS=0
HMMSEARCH_THREADS=2
MMSEQS_THREADS=4
MINIMAP2_THREADS=4
SKANI_THREADS=0

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME -i <long_reads.fastq/fa> -o <output_dir> --skani-db <GTDB_skani_db> [options]

Required arguments:
  -i, --input FILE             Input long accurate reads file, FASTQ/FASTA, optionally gzipped
  -o, --output DIR             Output directory
      --skani-db DIR           GTDB skani database directory

General thread argument:
  -t, --threads INT            Total CPU thread budget [default: 8]

Per-task thread arguments:
      --diamond-threads INT    Threads for the single DIAMOND blastx task [default: total threads]
      --hmmsearch-threads INT  Threads per hmmsearch task [default: 2]
      --mmseqs-threads INT     Threads per mmseqs easy-linclust task [default: 4]
      --minimap2-threads INT   Threads per minimap2 task [default: 4]
      --skani-threads INT      Threads for the single skani search task [default: total threads]

Optional arguments:
  -h, --help                   Show this help message and exit
  -v, --version                Show the version and exit

Database directory:
  The database directory is fixed to:
    SCRIPT_DIR/DB

  In this script:
    $DB_DIR

Required files in DB:
  markers.consensus.fa.dmnd
  *.hmm

Required helper scripts in SCRIPT_DIR:
  diamond.pep.pl
  hmmsearch2qc.pl
  split.marker.pl
  overlap.pl
  mcl2ID.pl
  fa2ID.pl
  hq.single.reads.pl
  cat-file.sh
  selection.pl
  extract.pl

Required external commands:
  diamond
  hmmsearch
  seqkit
  mmseqs
  minimap2
  mcl
  skani

Output structure:
  <output_dir>/
    01.diamond/
    02.split_diamond_output/
    03.hmmsearch/
    04.get_hq_marker/
    05.mmseqs_linclust/
    06.overlap_minimap2/
    07.mcl_cluster/
    08.select_representatives/
    09.skani_taxonomy/

Example:
  bash $PROGRAM_NAME \\
    -i reads.fastq.gz \\
    -o ICT_output \\
    -t 32 \\
    --hmmsearch-threads 2 \\
    --mmseqs-threads 4 \\
    --minimap2-threads 4 \\
    --skani-db /path/to/GTDB/skani/database
EOF
}

log() {
    printf '[%s] %s\n' "$(date +"%Y-%m-%d %H:%M:%S")" "$*" >&2
}

die() {
    log "[ERROR] $*"
    exit 1
}

check_command() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found in PATH: $1"
}

check_file() {
    [[ -f "$1" ]] || die "Required file not found: $1"
}

check_dir() {
    [[ -d "$1" ]] || die "Required directory not found: $1"
}

check_nonempty_file() {
    [[ -s "$1" ]] || die "File is missing or empty: $1"
}

check_positive_integer() {
    local value="$1"
    local name="$2"

    [[ "$value" =~ ^[0-9]+$ ]] || die "$name must be a positive integer"
    [[ "$value" -ge 1 ]] || die "$name must be >= 1"
}

parallel_jobs() {
    local per_task_threads="$1"
    local name="$2"

    check_positive_integer "$per_task_threads" "$name"

    local jobs=$((threads / per_task_threads))

    if [[ "$jobs" -lt 1 ]]; then
        jobs=1
    fi

    echo "$jobs"
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--input)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                INPUT_FILE="$2"
                shift 2
                ;;
            -o|--output)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                OUTPUT="$2"
                shift 2
                ;;
            -t|--threads)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                threads="$2"
                shift 2
                ;;
            --skani-db)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                SKANI_DB="$2"
                shift 2
                ;;
            --diamond-threads)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                DIAMOND_THREADS="$2"
                shift 2
                ;;
            --hmmsearch-threads)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                HMMSEARCH_THREADS="$2"
                shift 2
                ;;
            --mmseqs-threads)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                MMSEQS_THREADS="$2"
                shift 2
                ;;
            --minimap2-threads)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                MINIMAP2_THREADS="$2"
                shift 2
                ;;
            --skani-threads)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                SKANI_THREADS="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -v|--version)
                echo $VERSION
		exit 0
		;;
            *)
                die "Unknown argument: $1. Use -h or --help for usage."
                ;;
        esac
    done
}

check_thread_settings() {
    check_positive_integer "$threads" "--threads"

    if [[ "$DIAMOND_THREADS" -eq 0 ]]; then
        DIAMOND_THREADS="$threads"
    fi

    if [[ "$SKANI_THREADS" -eq 0 ]]; then
        SKANI_THREADS="$threads"
    fi

    check_positive_integer "$DIAMOND_THREADS" "--diamond-threads"
    check_positive_integer "$HMMSEARCH_THREADS" "--hmmsearch-threads"
    check_positive_integer "$MMSEQS_THREADS" "--mmseqs-threads"
    check_positive_integer "$MINIMAP2_THREADS" "--minimap2-threads"
    check_positive_integer "$SKANI_THREADS" "--skani-threads"

    if [[ "$DIAMOND_THREADS" -gt "$threads" ]]; then
        log "[WARN] --diamond-threads ($DIAMOND_THREADS) is greater than --threads ($threads); using $threads instead"
        DIAMOND_THREADS="$threads"
    fi

    if [[ "$HMMSEARCH_THREADS" -gt "$threads" ]]; then
        log "[WARN] --hmmsearch-threads ($HMMSEARCH_THREADS) is greater than --threads ($threads); using $threads instead"
        HMMSEARCH_THREADS="$threads"
    fi

    if [[ "$MMSEQS_THREADS" -gt "$threads" ]]; then
        log "[WARN] --mmseqs-threads ($MMSEQS_THREADS) is greater than --threads ($threads); using $threads instead"
        MMSEQS_THREADS="$threads"
    fi

    if [[ "$MINIMAP2_THREADS" -gt "$threads" ]]; then
        log "[WARN] --minimap2-threads ($MINIMAP2_THREADS) is greater than --threads ($threads); using $threads instead"
        MINIMAP2_THREADS="$threads"
    fi

    if [[ "$SKANI_THREADS" -gt "$threads" ]]; then
        log "[WARN] --skani-threads ($SKANI_THREADS) is greater than --threads ($threads); using $threads instead"
        SKANI_THREADS="$threads"
    fi
}

check_required_commands() {
    local required_commands=(
        diamond
        hmmsearch
        seqkit
        mmseqs
        minimap2
        mcl
        skani
    )

    for cmd in "${required_commands[@]}"; do
        check_command "$cmd"
    done
}

check_required_scripts() {
    local required_scripts=(
        diamond.pep.pl
        hmmsearch2qc.pl
        split.marker.pl
        overlap.pl
        mcl2ID.pl
        fa2ID.pl
        hq.single.reads.pl
        cat-file.sh
        selection.pl
        extract.pl
    )

    for script in "${required_scripts[@]}"; do
        check_file "$SCRIPT_script_DIR/$script"
    done
}

check_database_files() {
    check_dir "$DB_DIR"
    check_file "$DB_DIR/markers.consensus.fa.dmnd"

    compgen -G "$DB_DIR/*.hmm" >/dev/null || \
        die "No HMM files found in DB directory: $DB_DIR"

    log "[INFO] Database directory checked: $DB_DIR"
}

check_marker_hmm_files() {
    local marker_list="$1"

    check_nonempty_file "$marker_list"

    while read -r marker; do
        [[ -n "$marker" ]] || continue
        check_file "$DB_DIR/${marker}.hmm"
    done < "$marker_list"

    log "[INFO] Marker-specific HMM files checked: $marker_list"
}

preflight_checks() {
    [[ -n "$INPUT_FILE" ]] || die "Missing required argument: -i/--input"
    [[ -n "$OUTPUT" ]] || die "Missing required argument: -o/--output"
    [[ -n "$SKANI_DB" ]] || die "Missing required argument: --skani-db"

    check_thread_settings
    check_file "$INPUT_FILE"
    check_dir "$SKANI_DB"

    check_required_commands
    check_required_scripts
    check_database_files

    log "[INFO] Input file: $INPUT_FILE"
    log "[INFO] Output directory: $OUTPUT"
    log "[INFO] Total thread budget: $threads"
    log "[INFO] Fixed DB directory: $DB_DIR"
    log "[INFO] skani database: $SKANI_DB"
    log "[INFO] Preflight checks passed"
}

run_diamond() {
    local query_file="$1"
    local out_file="$2"

    diamond blastx \
        --db "$DB_DIR/markers.consensus.fa.dmnd" \
        --outfmt 6 qseqid qlen qstart qend qseq_translated sseqid \
        --max-target-seqs 50 \
        --target-indexed \
        -c1 \
        --query-gencode 11 \
        --threads "$DIAMOND_THREADS" \
        --query "$query_file" \
        --out "$out_file"
}

convert_to_bed_only_alignment() {
    local diamond_out="$1"
    local bed_out="$2"

    awk -F '[=\t]' '
        BEGIN {
            OFS="\t"
        }
        {
            chrom=$1
            len=$2
            pos1=$3
            pos2=$4
            marker=$5

            if (NF < 4 || len == "") next

            if (pos1 <= pos2) {
                start = pos1 - 1
                end = pos2
                strand = "+"
            } else {
                start = pos2 - 1
                end = pos1
                strand = "-"
            }

            name = chrom"="len"="pos1"="pos2"="marker
            print chrom, start, end, name, "0", strand

            name1 = chrom"="len
            print chrom, 0, len, name1, "0", "+"
        }
    ' "$diamond_out" > "$bed_out"
}

parse_args "$@"
preflight_checks

mkdir -p "$OUTPUT"

diamond_output="$OUTPUT/01.diamond"
split_diamond_output="$OUTPUT/02.split_diamond_output"
hmmsearch="$OUTPUT/03.hmmsearch"
get_hq_marker="$OUTPUT/04.get_hq_marker"
mmseqs_linclust="$OUTPUT/05.mmseqs_linclust"
overlap_minimap2="$OUTPUT/06.overlap_minimap2"
mcl_cluster="$OUTPUT/07.mcl_cluster"
select_representatives="$OUTPUT/08.select_representatives"
skani_taxonomy="$OUTPUT/09.skani_taxonomy"

mkdir -p \
    "$diamond_output" \
    "$split_diamond_output" \
    "$hmmsearch" \
    "$get_hq_marker" \
    "$mmseqs_linclust" \
    "$overlap_minimap2" \
    "$mcl_cluster" \
    "$select_representatives" \
    "$skani_taxonomy"

hmmsearch_jobs="$(parallel_jobs "$HMMSEARCH_THREADS" "--hmmsearch-threads")"
mmseqs_jobs="$(parallel_jobs "$MMSEQS_THREADS" "--mmseqs-threads")"
minimap2_jobs="$(parallel_jobs "$MINIMAP2_THREADS" "--minimap2-threads")"

log "[INFO] Thread settings:"
log "[INFO]   diamond:   ${DIAMOND_THREADS} threads, single task"
log "[INFO]   hmmsearch: ${HMMSEARCH_THREADS} threads/task, ${hmmsearch_jobs} parallel tasks"
log "[INFO]   mmseqs:    ${MMSEQS_THREADS} threads/task, ${mmseqs_jobs} parallel tasks"
log "[INFO]   minimap2:  ${MINIMAP2_THREADS} threads/task, ${minimap2_jobs} parallel tasks"
log "[INFO]   mcl:       ${threads} parallel tasks"
log "[INFO]   perl:      ${threads} parallel tasks"
log "[INFO]   skani:     ${SKANI_THREADS} threads, single task"

log "[STEP 1] DIAMOND blastx start"

run_diamond "$INPUT_FILE" "$diamond_output/diamond.prefilter.out"

check_nonempty_file "$diamond_output/diamond.prefilter.out"

log "[STEP 2] Split diamond output"

perl "$SCRIPT_script_DIR/diamond.pep.pl" \
    "$diamond_output/diamond.prefilter.out" \
    "$diamond_output"

find "$diamond_output" -maxdepth 1 -type f -name "PF*.pep" \
    -exec basename {} .pep \; \
    > "$diamond_output/used.PFAM.ID"

find "$diamond_output" -maxdepth 1 -type f -name "TIGR*.pep" \
    -exec basename {} .pep \; \
    > "$diamond_output/used.TIGR.ID"

cat "$diamond_output/used.PFAM.ID" "$diamond_output/used.TIGR.ID" \
    > "$diamond_output/used.ID"

check_nonempty_file "$diamond_output/used.ID"
check_marker_hmm_files "$diamond_output/used.ID"

log "[STEP 3] hmmsearch start"

if [[ -s "$diamond_output/used.TIGR.ID" ]]; then
    xargs -a "$diamond_output/used.TIGR.ID" -I {} -P "$hmmsearch_jobs" \
        hmmsearch \
            --cpu "$HMMSEARCH_THREADS" \
            -o "$split_diamond_output/{}.pep.hmmsearch" \
            --cut_nc \
            "$DB_DIR/{}.hmm" \
            "$diamond_output/{}.pep"
fi

if [[ -s "$diamond_output/used.PFAM.ID" ]]; then
    xargs -a "$diamond_output/used.PFAM.ID" -I {} -P "$hmmsearch_jobs" \
        hmmsearch \
            --cpu "$HMMSEARCH_THREADS" \
            -o "$split_diamond_output/{}.pep.hmmsearch" \
            --cut_ga \
            "$DB_DIR/{}.hmm" \
            "$diamond_output/{}.pep"
fi

log "[STEP 3] Filtering high-confidence HMM hits"
xargs -a "$diamond_output/used.ID" -I {} -P "$threads" \
    perl "$SCRIPT_script_DIR/hmmsearch2qc.pl" \
        "$split_diamond_output/{}.pep.hmmsearch" \
        "$split_diamond_output/{}.pep.hmmsearch.qc.ID"

find "$split_diamond_output" -maxdepth 1 -type f -name "*.pep.hmmsearch.qc.ID" -size +0c \
    -exec basename {} .pep.hmmsearch.qc.ID \; \
    > "$OUTPUT/used.marker.ID"

check_nonempty_file "$OUTPUT/used.marker.ID"

cat "$split_diamond_output"/*qc.ID | sort | uniq \
    > "$split_diamond_output/all.qc.ID"

check_nonempty_file "$split_diamond_output/all.qc.ID"

log "[STEP 3] Converting high-confidence marker positions to BED"

DIAMOND_OUT="$split_diamond_output/all.qc.ID"
ALIGNMENT_BED="$hmmsearch/alignment_only.bed"
ALIGNMENT_BED_uniq="$hmmsearch/alignment_only-uniq.bed"
FINAL_FASTQ="$hmmsearch/extracted_by_seqkit.fastq"

convert_to_bed_only_alignment "$DIAMOND_OUT" "$ALIGNMENT_BED"

check_nonempty_file "$ALIGNMENT_BED"

sort "$ALIGNMENT_BED" | uniq > "$ALIGNMENT_BED_uniq"

check_nonempty_file "$ALIGNMENT_BED_uniq"

log "[STEP 4] Extracting marker regions and 2 kb flanking sequences using seqkit"

seqkit subseq \
    --bed "$ALIGNMENT_BED_uniq" \
    -u 2000 \
    -d 2000 \
    -j "$threads" \
    "$INPUT_FILE" |
seqkit replace \
    -p '^(\S+)\s+(\S+).*$' \
    -r '$2' |
seqkit fx2tab -q |
awk -F '\t' '
    {
        name = $1
        seq  = $2
        qual = $3
        avgq = $4
        printf("@%s=%s\n%s\n+\n%s\n", name, avgq, seq, qual)
    }
' > "$FINAL_FASTQ"

check_nonempty_file "$FINAL_FASTQ"

log "[STEP 4] Splitting marker sequences and full-length reads"

perl "$SCRIPT_script_DIR/split.marker.pl" \
    "$FINAL_FASTQ" \
    "$hmmsearch"

check_nonempty_file "$hmmsearch/full.fasta"

log "[STEP 5] mmseqs easy-linclust start"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$mmseqs_jobs" \
    mmseqs easy-linclust \
        "$hmmsearch/{}.fasta" \
        "$get_hq_marker/{}" \
        "$get_hq_marker/{}.tmp" \
        --cov-mode 5 \
        -c 0.9 \
        --min-seq-id 0.97 \
        --threads "$MMSEQS_THREADS"

log "[STEP 6] minimap2 overlap detection start"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$minimap2_jobs" \
    minimap2 \
        -t "$MINIMAP2_THREADS" \
        -Hk19 \
        -Xw19 \
        -e0 \
        -m100 \
        -c \
        "$get_hq_marker/{}_rep_seq.fasta" \
        "$get_hq_marker/{}_rep_seq.fasta" \
        -o "$mmseqs_linclust/{}.paf"

log "[STEP 6] Inferring overlapping read-pair relationships"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    perl "$SCRIPT_script_DIR/overlap.pl" \
        -i "$mmseqs_linclust/{}.paf" \
        -o "$mmseqs_linclust/{}.paf.pair"

log "[STEP 7] MCL clustering"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    mcl "$mmseqs_linclust/{}.paf.pair" \
        --abc \
        -o "$overlap_minimap2/{}.paf.pair.mcl"

log "[STEP 7] Extracting MCL cluster IDs"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    perl "$SCRIPT_script_DIR/mcl2ID.pl" \
        "$overlap_minimap2/{}.paf.pair.mcl" \
        "$overlap_minimap2/{}.paf.pair.mcl.ID"

log "[STEP 8] Extracting representative sequence IDs"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    perl "$SCRIPT_script_DIR/fa2ID.pl" \
        "$get_hq_marker/{}_rep_seq.fasta" \
        "$mcl_cluster/{}_rep_seq.fasta.ID"

log "[STEP 8] Selecting high-quality singleton reads"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    perl "$SCRIPT_script_DIR/hq.single.reads.pl" \
        "$overlap_minimap2/{}.paf.pair.mcl.ID" \
        "$mcl_cluster/{}_rep_seq.fasta.ID" \
        "$mcl_cluster/{}.hq.single.ID"

log "[STEP 8] Merging MCL clusters and high-quality singleton reads"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    bash "$SCRIPT_script_DIR/cat-file.sh" \
        "$overlap_minimap2/{}.paf.pair.mcl" \
        "$mcl_cluster/{}.hq.single.ID" \
        "$mcl_cluster/{}.cluster"

log "[STEP 8] Expanding clusters to original mmseqs members"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    perl "$SCRIPT_script_DIR/selection.pl" \
        "$get_hq_marker/{}_cluster.tsv" \
        "$mcl_cluster/{}.cluster" \
        "$select_representatives/{}.expanded.cluster" \
        "$select_representatives/{}.expanded.cluster.rep.ID"

log "[STEP 8] Extracting full-length representative sequences"

xargs -a "$OUTPUT/used.marker.ID" -I {} -P "$threads" \
    perl "$SCRIPT_script_DIR/extract.pl" \
        "$select_representatives/{}.expanded.cluster.rep.ID" \
        "$hmmsearch/full.fasta" \
        "$select_representatives/{}.expanded.cluster.rep.fullseq.fasta"

log "[STEP 8] Merging full-length representative sequences"

cat "$select_representatives"/*.expanded.cluster.rep.fullseq.fasta \
    > "$select_representatives/all.expanded.cluster.rep.fullseq.fasta"

check_nonempty_file "$select_representatives/all.expanded.cluster.rep.fullseq.fasta"

log "[STEP 9] skani taxonomy assignment"

SKANI_INPUT="$select_representatives/all.expanded.cluster.rep.fullseq.fasta"
SKANI_OUTPUT="$skani_taxonomy/used.marker.Cluster.Taxonomy.skani.out"

check_nonempty_file "$SKANI_INPUT"

skani search \
    -n 20 \
    -d "$SKANI_DB" \
    --qi "$SKANI_INPUT" \
    -o "$SKANI_OUTPUT" \
    -t "$SKANI_THREADS"

check_nonempty_file "$SKANI_OUTPUT"

log "[DONE] ICT workflow finished successfully"
log "[DONE] Final taxonomy output: $SKANI_OUTPUT"
